              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"venueId\": \"{{venueId}}\",\n  \"eventName\": \"Workshop de Node.js\",\n  \"description\": \"Aprenda Node.js do zero ao avançado\",\n  \"date\": \"2025-12-20T00:00:00.000Z\",\n  \"startTime\": \"2025-12-20T14:00:00.000Z\",\n  \"endTime\": \"2025-12-20T18:00:00.000Z\"\n}"
            },
